          "id": "ef22edf4-b7e8-43f7-91cd-40572ca7b68f",
          "name": "Get Single Symbol Price",
          "request": {
            "name": "Get Single Symbol Price",
            "description": {
              "content": "Returns the latest aggregated price for a single source cryptocurrency converted into one or more target currencies. Uses CCCAGG by default.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "price"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fsym",
                  "value": "<string>",
                  "description": "(Required) From-symbol (base cryptocurrency symbol), e.g. BTC."
                },
                {
                  "disabled": false,
                  "key": "tsyms",
                  "value": "<string>",
                  "description": "(Required) Comma-separated to-symbols (target currencies), e.g. USD,EUR."
                },
                {
                  "disabled": false,
                  "key": "e",
                  "value": "CCCAGG",
                  "description": "Source exchange (default CCCAGG aggregate index)."
                },
                {
                  "disabled": false,
                  "key": "tryConversion",
                  "value": "true",
                  "description": "When false, do not multi-hop convert via BTC if a direct pair is unavailable."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
