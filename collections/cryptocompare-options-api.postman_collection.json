                  "value": "<string>",
                  "description": "(Required) Spot or derivatives market (e.g. coinbase, kraken, binance, bitstamp, ccix)."
                },
                {
                  "disabled": false,
                  "key": "instruments",
                  "value": "<string>",
                  "description": "(Required) Comma-separated instrument identifiers (e.g. BTC-USD,ETH-USD)."
